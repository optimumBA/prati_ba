<div class="w-full h-full absolute">
  <ArticleComponent.navbar socket={@socket} />

  <section class="w-full flex justify-center items-center">
    <div class="block">
      <%= for {article, index} <- Enum.with_index(@articles) do %>
        <ArticleComponent.article article={article} index={index} socket={@socket} />
      <% end %>
    </div>
  </section>
</div>
