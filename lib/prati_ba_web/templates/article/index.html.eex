<%= for category <- @categories do %>
<%= unless Enum.empty?(category.articles) do %>
<section class="category">
  <h5><%= category.name %></h5>

  <section class="articles">
  <%= for article <- category.articles do %>
    <article>
      <%= link to: Routes.article_path(@conn, :show, article), class: "article", target: "_blank", rel: "noopener" do %>
        <div class="article-image">
          <%= article_image_tag(article) %>
        </div>

        <div class="article-details">
          <div class="article-title"><%= article.title %></div>

          <div class="article-info">
            <span class="article-source"><%= article.source.name %></span>
            |
            <%= published_date(article) %>
          </div>
        </div>
      <% end %>
    </article>
  <% end %>
  </section>
</section>
<% end %>
<% end %>
