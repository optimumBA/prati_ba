<!DOCTYPE html>
<html lang="bs">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content={csrf_token_value()}>
  <%= live_title_tag assigns[:page_title] || "Prati.ba" %>
    <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css" )} />
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js" )}></script>
    <script defer data-domain={PratiBaWeb.Endpoint.host()} src="https://plausible.io/js/script.js">
    </script>
    <%= if assigns[:analytics_token] do %>
      <script type="text/javascript">
        window.analyticsToken = "<%= assigns[:analytics_token] %>";
      </script>
    <% end %>
    <script>
      if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark')
      }
    </script>
</head>
<body class="relative dark:bg-[#212936]">
  <%= @inner_content %>
</body>
</html>
