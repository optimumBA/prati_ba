<!DOCTYPE html>
<html lang="bs">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content={csrf_token_value()}>
  <.live_title>
      <%= assigns[:page_title] || "Prati.ba" %>
    </.live_title>
  <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <!-- Google fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
  <script defer data-domain={PratiBaWeb.Endpoint.host()} src="https://plausible.io/js/script.js">
  </script>
  <%= if assigns[:analytics_token] do %>
    <script type="text/javascript">
      window.analyticsToken = "<%= assigns[:analytics_token] %>";
    </script>
  <% end %>
</head>
<body class="relative dark:bg-[#212936] font-inter">
  <%= @inner_content %>
</body>
</html>
